generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum EDataStatus {
  SEMUA
  USER
}

enum ETransactionType {
  WITHDRAW
  DEPOSIT
  PROFIT
  LOSS
}

enum EMode {
  IN
  OUT
}

enum EBotType {
  TRADING
  SCANNER
  SMC
}

model Role {
  id          String      @id @default(uuid())
  name        String
  permission  String      @db.Text
  data_status EDataStatus @default(SEMUA)

  status     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  User       User[]
}

model User {
  id       String  @id @default(uuid())
  fullname String
  nik      String?
  nip      String?
  phone    String?
  email    String?
  username String  @unique
  password String

  status        Boolean         @default(true)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @default(now())
  Role          Role            @relation(fields: [roleId], references: [id], onUpdate: Cascade)
  roleId        String
  LogActivities LogActivities[]
  Wallets       Wallet[]
}

model UserSubscription {
  id       String   @id @default(uuid())
  start_at DateTime @default(now())
  end_at   DateTime
  status   Boolean  @default(true)
}

model Subscription {
  id          String  @id @default(uuid())
  name        String
  price       Int
  max_bot     Int
  description String? @db.Text
  benefit     String  @db.Text

  status     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

model Wallet {
  id           String        @id @default(uuid())
  User         User          @relation(fields: [userId], references: [id])
  userId       String
  Transactions Transaction[]
}

model Transaction {
  id     String           @id @default(uuid())
  type   ETransactionType
  mode   EMode
  amount Int
  desc   String?
  fee    Int

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  Wallet     Wallet   @relation(fields: [walletId], references: [id])
  walletId   String
}

model Pair {
  id   String @id @default(uuid())
  name String @unique

  status       Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @default(now())
  Trades       Trade[]
  PumpScanners PumpScanner[]
}

model Trade {
  id       String  @id @default(uuid())
  side     String
  open     Float
  close    Float?
  amount   Float
  lev      Float
  tp_price Float?
  sl_price Float?
  pnl      Float   @default(0)
  reason   String?
  summary  String? @db.Text

  open_time  DateTime  @default(now())
  close_time DateTime?
  Pair       Pair      @relation(fields: [pairId], references: [id])
  pairId     String
  Bot        Bot?      @relation(fields: [botId], references: [id])
  botId      String?
}

model PumpScanner {
  id      String  @id @default(uuid())
  reason  String?
  open    Float
  sl      Float
  tp      Float
  summary String  @db.Text
  active  Boolean @default(true)

  status     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  Pair       Pair     @relation(fields: [pairId], references: [id])
  pairId     String
  Bot        Bot      @relation(fields: [botId], references: [id])
  botId      String
}

model Bot {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  active      Boolean  @default(false)
  type        EBotType

  status       Boolean       @default(true)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt
  BotLogs      BotLog[]
  Trades       Trade[]
  PumpScanners PumpScanner[]
}

model BotLog {
  id     String   @id @default(uuid())
  reason String?  @db.Text
  date   DateTime @default(now())
  Bot    Bot      @relation(fields: [botId], references: [id])
  botId  String
}

model LogActivities {
  id         String   @id @default(uuid())
  method     String
  status     String
  ip         String
  userAgent  String
  User       User     @relation(fields: [userId], references: [id], onUpdate: Cascade)
  userId     String
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt
}
